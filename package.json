{
  "name": "monopoly-arena",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/engine",
    "packages/web"
  ],
  "scripts": {
    "test": "npm run test --workspace=@monopoly-arena/engine",
    "dev": "npm run dev --workspace=@monopoly-arena/web",
    "build": "npm run build --workspace=@monopoly-arena/engine && npm run build --workspace=@monopoly-arena/web",
    "batch": "npm run build --workspace=@monopoly-arena/engine && node packages/engine/dist/batch-cli.js"
  }
}
